# =============================================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# =============================================================

# [OBRIGATÓRIO] URL de conexão com o PostgreSQL
DATABASE_URL=postgresql://postgres:sua_senha@postgres:5432/zapgroup

# =============================================================
# SEGURANÇA
# =============================================================

# [OBRIGATÓRIO] Chave secreta usada para assinar e validar os tokens JWT do sistema (mínimo 32 caracteres)
JWT_SECRET=troque_por_uma_chave_aleatoria_de_no_minimo_32_chars

# [OPCIONAL] API Key mestra para integrações externas (ex: n8n, webhooks)
API_SECRET=troque_por_uma_chave_aleatoria_de_no_minimo_32_chars

# [OPCIONAL] Tempo de expiração do Token JWT em minutos (padrão 1440 = 24 horas)
JWT_EXPIRE_MINUTES=1440

# =============================================================
# SUPER ADMIN (criado automaticamente no startup)
# =============================================================

# [OBRIGATÓRIO] E-mail do usuário administrador master
SUPER_ADMIN_EMAIL=admin@seudominio.com

# [OBRIGATÓRIO] Senha do usuário administrador master
SUPER_ADMIN_PASSWORD=troque_por_uma_senha_forte

# =============================================================
# WORKER / AGENDADOR DE TAREFAS
# =============================================================

# [OPCIONAL] Define se o agendador embutido na API deve ser desativado quando houver container worker separado
DISABLE_SCHEDULER=false

# =============================================================
# REDIS (Rate Limiting)
# =============================================================

# [OBRIGATÓRIO] URL de conexão com o Redis
REDIS_URL=redis://redis:6379

# =============================================================
# RABBITMQ (Fila AMQP para Disparos e Extração Sequencial 1 por vez)
# =============================================================

# [OPCIONAL] URL de conexão com o RabbitMQ (formato: amqp://usuario:senha@host:5672/)
RABBITMQ_URL=amqp://admin:admin@rabbitmq:5672/

# [OPCIONAL] Habilita o enfileiramento sequencial de disparos e extrações (true/false)
RABBITMQ_ENABLED=true

# [OPCIONAL] Tempo de pausa em segundos entre cada tarefa da fila (padrão: 2 segundos)
RABBITMQ_DELAY_SECONDS=2



# =============================================================
# CORS / HOSTS PERMITIDOS
# =============================================================

# [OPCIONAL] Origens permitidas pelo CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5176

# [OPCIONAL] Hosts confiáveis para o TrustedHostMiddleware
ALLOWED_HOSTS=*

# =============================================================
# URLs DO SISTEMA
# =============================================================

# [OBRIGATÓRIO] URL pública do backend (usada para gerar links de redirecionamento /join)
BASE_URL=https://api.seudominio.com

# [OBRIGATÓRIO] URL do frontend (usada para páginas de esgotamento e interface)
FRONTEND_URL=http://localhost:5173

# =============================================================
# ARMAZENAMENTO S3 (para mídia e backups no Backblaze B2 S3)
# =============================================================

# [OPCIONAL] Endpoint do serviço S3 compatível (ex: Backblaze B2, Cloudflare R2, AWS)
S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com

# [OPCIONAL] Chave de acesso S3
S3_ACCESS_KEY_ID=sua_chave_de_acesso_s3

# [OPCIONAL] Chave secreta S3
S3_SECRET_ACCESS_KEY=sua_chave_secreta_s3

# [OPCIONAL] Nome do bucket S3
S3_BUCKET_NAME=nome-do-seu-bucket

# [OPCIONAL] Região do bucket S3
S3_REGION=us-west-004

